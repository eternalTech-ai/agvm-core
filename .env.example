OPENAI_API_KEY=
AGVM_ALLOW_SETUP_WITHOUT_PROVIDER=true
AGVM_LLM_ENABLED=true
AGVM_COMPILER_MODEL=gpt-4o-mini
AGVM_PLANNER_MODEL=gpt-5
AGVM_AI_SPATIAL_MODEL=gpt-5-mini
AGVM_EVIDENCE_JUDGE_MODEL=gpt-5
AGVM_MASTER_MODEL=gpt-5
AGVM_GROW_SEMANTIC_MODEL=gpt-5

AGVM_API_PORT=8010
AGVM_UI_PORT=3020
AGVM_LAB_DATA_DIR=
AGVM_BRAINS_DIR=

AGVM_DEFAULT_BRAIN_ID=default_brain
AGVM_MCP_BRAIN_POLICY=ai_create_if_missing
AGVM_MCP_BRAIN_ID=
AGVM_MCP_BRAIN_ID_HINT=
AGVM_MCP_BRAIN_DISPLAY_NAME=AGVM Local Memory
AGVM_MCP_BRAIN_PURPOSE=Persistent local MCP memory for this AI client.
AGVM_MCP_READ_ONLY=false
AGVM_MCP_TIMEOUT_SECONDS=180
AGVM_MCP_MODULE_VISIBILITY_POLICY=block_unlicensed
# Optional cloud-backed Maintain handoff. Leave the key empty for Local Core.
# A Hosted MCP key comes from the user's Detwin account and is required only
# for metered tools such as Sleep and Evolve; it is not used by local Bootstrap,
# Grow or Context/Search.
AGVM_HOSTED_MCP_URL=https://mcp.detwin.ai
AGVM_HOSTED_MCP_API_KEY=
# Leave empty to let first-run setup generate and persist a random value.
# If supplied explicitly, use at least 32 bytes and never commit the value.
AGVM_GROW_PREVIEW_BINDING_SECRET=
VITE_PLATFORM_URL=https://app.detwin.ai
